+        if (table.labels.empty())
+        {
+            // No bounds check before the table (the compiler knew the index
+            // was in range), so the table's length comes from the table
+            // itself: it runs up to the first case's code, which the lowest
+            // entry names. Every entry is a code address at or after the
+            // table; anything else ends it.
+            size_t lowest = SIZE_MAX;
+            for (size_t i = 0; i < 4096; i++)
+            {
+                const size_t entryAddress = pOffset + i * 4;
+                if (entryAddress >= lowest)
