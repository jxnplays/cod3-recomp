+                const uint32_t label = offsets[i];
+                if ((label & 3) != 0 || label <= entryAddress || label > pOffset + 0x100000 || image.Find(label) == nullptr)
+                    break;
+                table.labels.push_back(label);
+                lowest = std::min<size_t>(lowest, label);
+            }
+        }
         for (size_t i = 0; i < table.labels.size(); i++)
         {
             table.labels[i] = offsets[i];
